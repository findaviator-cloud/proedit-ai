# Copy to .env for local dev, or set these as env vars on your host (Docker/HF Spaces/Render/etc).

# Comma-separated list of origins allowed to call this API. Required in production —
# without it CORS defaults to "*" (open to any website) and the server logs a warning.
ALLOWED_ORIGINS=https://yourdomain.com

# Port the Flask/gunicorn server listens on.
PORT=7860

# Per-request payload limits.
MAX_IMAGE_MB=20
MAX_DIMENSION=4096
MAX_BULK=20
MAX_WORKERS=2

# Simple per-IP rate limit (requests/minute). 0 disables it.
RATE_LIMIT_PER_MIN=30

# Smart Crop: minimum fraction of the (downscaled) frame the detected document
# must cover to be accepted (0.15 = 15%). Lower it if documents are being
# missed when photographed from far away; raise it if small unrelated
# rectangles (windows, tiles) are being picked up instead of the document.
DOC_MIN_AREA_FRAC=0.08

LOG_LEVEL=INFO
